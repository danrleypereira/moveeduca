{
  "name": "vrv-bpmn",
  "version": "1.0.0",
  "description": "BPMN Viewer and Engine",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS='--no-deprecation' nodemon --exec node --loader ts-node/esm src/index.ts",
    "build": "rimraf dist && tsc && npm run copy-assets",
    "start": "node dist/index.js",
    "copy-assets": "cpx \"src/public/**\" dist/public/ && cpx \"src/bpmn-definitions/**\" dist/bpmn-definitions/"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bpmn-engine": "^25.0.1",
    "cors": "^2.8.6",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.3.5",
    "cpx": "^1.5.0",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
