# Configuração do SendGrid para envio de emails
# Copie este arquivo para .env e preencha com suas credenciais

# API Key do SendGrid (obrigatório)
# Gere em: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=

# Email do remetente (obrigatório - deve estar verificado no SendGrid)
SENDGRID_FROM_EMAIL=seu-email@dominio.com

# Nome do remetente (deve corresponder ao configurado no SendGrid)
SENDGRID_FROM_NAME=Maestro Engine Test
